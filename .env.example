# Backend Configuration
NODE_ENV=development
PORT=4000

# Neon PostgreSQL connection string (copy from Neon Dashboard -> Connect).
# Keep this secret; use the pooled connection string with sslmode=require.
DATABASE_URL=

# Strong random secret (min 16 chars, required in production)
JWT_SECRET=replace-with-strong-32-char-random-secret
JWT_EXPIRES_IN=7d

# Frontend URL & CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Browser Worker Configuration
WORKER_PORT=4001
WORKER_URL=http://localhost:4001
WORKER_SHARED_SECRET=replace-with-worker-shared-secret
WORKER_MAX_SESSIONS=8
WORKER_SESSION_TTL_MS=1200000
WORKER_NAV_TIMEOUT_MS=25000

# Optional Redis + BullMQ Job Queue
REDIS_URL=
USE_BULLMQ=false

# Optional S3-Compatible Object Storage (falls back to local /uploads in dev)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Frontend Build Variables (frontend/.env)
VITE_API_URL=/api
VITE_SOCKET_URL=/
